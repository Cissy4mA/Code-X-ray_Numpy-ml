# 复制为 .env 并按本机环境修改（.env 已被 .gitignore 忽略，不会上传）

# ---- 默认数据库：仓库自带 SQLite 演示索引，clone 后可直接运行 ----
DB_BACKEND=sqlite
SQLITE_PATH=data/code_x_ray.sqlite3

# ---- 公网部署时关闭清库、导入、调试和评测接口 ----
ENABLE_ADMIN_API=0

# ---- MySQL（仅当 DB_BACKEND=mysql 时使用）----
MYSQL_HOST=127.0.0.1
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_PORT=3306
MYSQL_DB=code_x_ray

# ---- Embedding 模型下载（国内网络建议设镜像，否则下载慢/超时）----
# 清华/阿里等 HF 镜像任选其一
HF_ENDPOINT=https://hf-mirror.com

# 查询和索引必须使用相同的模型与固定版本；更改后运行 scripts/reembed_all.py。
EMBEDDING_BACKEND=local
EMBEDDING_LOCAL_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_LOCAL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41

# ---- 可选：走兼容 Embedding API（需设 EMBEDDING_BACKEND=api 并全量重建）----
# EMBEDDING_API_KEY=sk-xxx
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
