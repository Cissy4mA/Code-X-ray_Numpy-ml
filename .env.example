# Copy to .env and adjust for your local environment (.env is gitignored and will not be uploaded)

# ---- Default database: bundled SQLite demo index, runs right after clone ----
DB_BACKEND=sqlite
SQLITE_PATH=data/code_x_ray.sqlite3

# ---- In public deployment, disable DB reset, import, debug, and evaluation endpoints ----
ENABLE_ADMIN_API=0

# ---- MySQL (used only when DB_BACKEND=mysql) ----
MYSQL_HOST=127.0.0.1
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_PORT=3306
MYSQL_DB=code_x_ray

# ---- Embedding model download (set a mirror in slow networks to avoid timeouts) ----
# Pick any HF mirror such as Tsinghua or Aliyun
HF_ENDPOINT=https://hf-mirror.com

# Query and index must use the same model and pinned version; after changing, run scripts/reembed_all.py.
EMBEDDING_BACKEND=local
EMBEDDING_LOCAL_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_LOCAL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41

# ---- Optional: use a compatible Embedding API (set EMBEDDING_BACKEND=api and rebuild all) ----
# EMBEDDING_API_KEY=sk-xxx
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
